# --- Threads API (https://developers.facebook.com/documentation/threads) ---
# Довготривалий (60 днів) user access token з дозволами threads_basic + threads_keyword_search.
# Якщо порожньо — сайт працює в демо-режимі з вигаданими постами.
THREADS_ACCESS_TOKEN=

# RECENT (найновіші) або TOP (найпопулярніші)
THREADS_SEARCH_TYPE=RECENT

# Скільки постів аналізувати за один пошук (10–500). Більше = точніше, але більше запитів і витрат.
MAX_POSTS=100

# --- Claude API (https://console.anthropic.com) ---
# Якщо порожньо — використовується спрощений словниковий аналіз.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Сервер ---
# Скільки секунд зберігати результат по бренду (економить ліміти)
CACHE_TTL_SECONDS=3600
# Максимум пошуків з однієї IP за хвилину
RATE_LIMIT_PER_MINUTE=10

# --- Футер і юридичні сторінки (/privacy, /cookies) ---
NEXT_PUBLIC_SITE_URL=https://www.hovir.live
NEXT_PUBLIC_OPERATOR=ФОП Прізвище Ім'я По батькові
NEXT_PUBLIC_OPERATOR_CITY=Київ, Україна
NEXT_PUBLIC_CONTACT_EMAIL=contact.app.creator@gmail.com
